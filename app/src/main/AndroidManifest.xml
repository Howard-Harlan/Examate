<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    >

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- 课表课前提醒:Android 12+ 精确闹钟 -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- 开机后重新调度提醒 -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- 网络状态:Nostr 中继连接检测 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 局域网聊天:UDP 广播直连,普通权限即可;组播锁提高休眠时收到广播包的可靠性 -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- P2P 直连(可选功能,路由器 AP 隔离时的点对点通道,按需运行时申请):
         Android 13+ 为 NEARBY_WIFI_DEVICES(neverForLocation),12 及以下为 ACCESS_FINE_LOCATION -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-permission
        android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />

    <!-- 音乐:本地音频扫描改用 SAF 目录树授权(OpenDocumentTree),无需 READ_MEDIA_AUDIO / READ_EXTERNAL_STORAGE 大权限 -->

    <!-- Mesh 聊天:语音消息录制 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />


    <application
        android:name=".ExamateApp"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Examate">
        <service
            android:name=".service.UnifiedFloatingService"
            android:foregroundServiceType="mediaProjection" />
        <!-- Mesh 聊天悬浮窗服务(ComposeView 挂载到 WindowManager,与主界面共享 MesChatController 单例) -->
        <service android:name=".meschat.MesChatFloatingService"/>
        <!-- 求是悬浮窗服务(独立于搜题管线的轻量 AI 问答窗) -->
        <service android:name=".service.QiushiFloatingService"/>
        <service
            android:name=".service.MyAccessibilityService"
            android:description="@string/description_in_xml"
            android:exported="true"
            android:enabled="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
        <service
            android:name=".service.MyQSTileService"
            android:label="@string/app_name"
            android:icon="@drawable/ic_launcher_foreground"
            android:exported="true"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <activity
            android:name=".OnboardingActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MainActivity"
            android:screenOrientation="portrait" />
        <activity
            android:name=".DeepLearningActivity"
            android:label="Deep Learning"
            android:screenOrientation="portrait" />
        <activity
            android:name=".notes.MemoActivity"
            android:label="速记"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ApiConfigActivity"
            android:label="API设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".WebViewActivity"
            android:label="网页"
            android:screenOrientation="portrait" />
        <activity
            android:name=".UserScriptActivity"
            android:label="脚本"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ChatActivity"
            android:label="Agents"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".meschat.MesChatActivity"
            android:label="Mesh 聊天"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CampusServiceActivity"
            android:label="校园服务"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".WaterCardActivity"
            android:label="乐校通水卡"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PdfPreviewActivity"
            android:label="PDF预览"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ScheduleActivity"
            android:label="课程表"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".TodoActivity"
            android:label="待办"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DownloaderActivity"
            android:label="下载"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".DownloadSettingsActivity"
            android:label="下载设置"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ReadingActivity"
            android:label="阅读"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- 系统打开文本类文件快捷打开:txt/md/html/log/csv/json/xml/epub -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="text/*" />
                <data android:mimeType="application/epub+zip" />
                <data android:mimeType="application/xml" />
                <data android:mimeType="application/json" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.txt" />
                <data android:pathPattern=".*\\.md" />
                <data android:pathPattern=".*\\.html" />
                <data android:pathPattern=".*\\.htm" />
                <data android:pathPattern=".*\\.log" />
                <data android:pathPattern=".*\\.csv" />
                <data android:pathPattern=".*\\.epub" />
            </intent-filter>
        </activity>
        <activity
            android:name=".MusicActivity"
            android:label="音乐"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- 系统打开音乐类文件快捷打开:mp3/flac/m4a/wav/ogg/aac/opus -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" />
                <data android:scheme="file" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="application/ogg" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.opus" />
            </intent-filter>
        </activity>

        <!-- 音乐后台播放:前台服务 + 通知栏控制 -->
        <service
            android:name=".music.MusicPlaybackService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <activity
            android:name=".music.bili.BiliLoginActivity"
            android:label="B站登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.auth.NeteaseLoginActivity"
            android:label="网易云登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.auth.TxLoginActivity"
            android:label="QQ音乐登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.auth.KugouLoginActivity"
            android:label="酷狗登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.auth.KuwoLoginActivity"
            android:label="酷我登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".music.auth.MiguLoginActivity"
            android:label="咪咕登录"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ScheduleWebImportActivity"
            android:label="网页导入课表"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ScheduleSettingsActivity"
            android:label="课表设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".UserSettingsActivity"
            android:label="用户设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AgentSettingsActivity"
            android:label="Agent 设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".AboutActivity"
            android:label="关于"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SearchSettingsActivity"
            android:label="搜题功能设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".SystemSettingsActivity"
            android:label="系统设置"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CacheManagerActivity"
            android:label="缓存管理"
            android:screenOrientation="portrait" />
        <activity
            android:name=".notes.NotesActivity"
            android:label="笔记"
            android:exported="true"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize">
            <!-- deep link:外部传 noteId 直接打开对应笔记 -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- 文件分享/打开:把沙箱生成的文件暴露为 content:// URI -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- 今日课表桌面小组件 -->
        <receiver
            android:name=".widget.ScheduleWidgetProvider"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_schedule_info" />
        </receiver>
        <!-- 课表课前提醒:接收闹钟触发 + 开机后重新调度 -->
        <receiver
            android:name=".campus.ScheduleReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="go.examate.hyp.SCHEDULE_REMINDER" />
                <action android:name="go.examate.hyp.SCHEDULE_RESCHEDULE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Shizuku API -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:enabled="true"
            android:exported="true"
            android:multiprocess="false"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
        <activity
            android:name=".LePaoActivity"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".lepao.LePaoScanLoginActivity"
            android:label="步道乐跑"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize" />
    </application>

</manifest>








<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_float_card"
    android:elevation="4dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_float_input"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/title_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textStyle="bold"
            android:textSize="11sp"
            android:text="屏幕搜词"
            android:textColor="@color/text_secondary"/>

    </LinearLayout>

    <!-- 内容 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:padding="6dp"
        android:scrollbarThumbVertical="@color/bg_divider">

        <TextView
            android:id="@+id/contentOutput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:padding="3dp"
            android:textIsSelectable="true"
            android:text="设置搜索词，然后操作界面"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </ScrollView>

    <!-- 输入框 -->
    <EditText
        android:id="@+id/contentInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:hint="搜索关键词..."
        android:textColor="@color/text_secondary"
        android:textColorHint="@color/text_hint"
        android:background="@drawable/bg_float_input"
        android:padding="6dp"
        android:layout_marginStart="6dp"
        android:layout_marginEnd="6dp"
        android:layout_marginBottom="4dp"
        android:textSize="12sp"
        android:singleLine="true"/>

    <!-- 按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingBottom="6dp">

        <Button
            android:id="@+id/close_btn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/btn_float_outline"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:padding="2dp"
            android:layout_marginEnd="3dp"
            android:text="关闭"/>

        <Button
            android:id="@+id/submit_btn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/btn_float_primary"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:padding="2dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="搜索"/>

        <Button
            android:id="@+id/copy_btn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/btn_float_outline"
            android:textColor="@color/text_secondary"
            android:textSize="10sp"
            android:padding="2dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="3dp"
            android:text="复制"/>

        <Button
            android:id="@+id/ask_btn"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:background="@drawable/btn_float_accent"
            android:textColor="@color/white"
            android:textSize="10sp"
            android:padding="2dp"
            android:layout_marginStart="3dp"
            android:text="AI"/>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <go.examate.hyp.service.SelectionOverlayView
        android:id="@+id/selection_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 底部按钮栏(框选完成后显示) -->
    <LinearLayout
        android:id="@+id/bottom_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="48dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_back"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_float_white"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="返回"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_reselect"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/btn_float_white"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="重新框选"
            android:textColor="@color/text_hint"
            android:textSize="13sp" />

        <Button
            android:id="@+id/btn_ask_ai"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_lan_chat_send"
            android:minWidth="80dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="问 AI"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>

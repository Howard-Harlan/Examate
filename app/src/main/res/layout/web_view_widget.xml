<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_float_50">

    <!-- 地址栏 -->
    <LinearLayout
        android:id="@+id/title_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="3dp">

        <!-- 拖动手柄：专门用来拖动窗口 -->
        <TextView
            android:id="@+id/drag_handle"
            android:layout_width="22dp"
            android:layout_height="28dp"
            android:background="@drawable/btn_float_white"
            android:gravity="center"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:text="≡"
            android:clickable="true"
            android:focusable="true" />

        <Button
            android:id="@+id/go_back_btn"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_float_white"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:padding="2dp"
            android:text="@string/back" />

        <EditText
            android:id="@+id/url_box"
            android:layout_width="0dp"
            android:layout_height="28dp"
            android:layout_weight="1"
            android:layout_marginStart="2dp"
            android:textSize="10sp"
            android:background="@drawable/bg_float_input_30"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:imeOptions="actionGo"
            android:hint="URL"
            android:textColor="@color/text_hint"
            android:textColorHint="#809CA3AF"
            android:inputType="textUri"/>

        <Button
            android:id="@+id/go_to_btn"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_float_white"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:padding="2dp"
            android:text="Go" />

        <Button
            android:id="@+id/close_btn"
            android:layout_width="32dp"
            android:layout_height="28dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/btn_float_white"
            android:textColor="@color/text_hint"
            android:textSize="11sp"
            android:padding="2dp"
            android:text="X" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="280dp"
        android:layout_height="360dp"
        android:layout_margin="3dp"
        android:background="#4DFFFFFF">

        <WebView
            android:id="@+id/web_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

</LinearLayout>

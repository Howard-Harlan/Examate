<?xml version="1.0" encoding="utf-8"?>
<!-- 求是悬浮窗(重设计版):深色玻璃卡片,标题栏拖拽 / 输出滚动 / 底部输入+发送。
     所有控件 ID 与 QiushiFloatingService 绑定,勿改名。 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qiushi_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_qiushi_window">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingBottom="10dp">

        <!-- ═══ 标题栏(拖拽移动) ═══ -->
        <LinearLayout
            android:id="@+id/qiushi_title_bar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/bg_qiushi_dot" />

            <TextView
                android:id="@+id/qiushi_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:textStyle="bold"
                android:textSize="13sp"
                android:text="求是"
                android:textColor="#FFE8EAED" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp"
                android:text="多轮深挖"
                android:textSize="10sp"
                android:textColor="#66E8EAED" />

            <Button
                android:id="@+id/qiushi_close_btn"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:background="@drawable/btn_qiushi_close"
                android:textColor="#CCE8EAED"
                android:textSize="12sp"
                android:padding="0dp"
                android:text="✕" />

        </LinearLayout>

        <!-- ═══ 输出区(滚动) ═══ -->
        <ScrollView
            android:id="@+id/qiushi_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:scrollbarThumbVertical="@drawable/bg_qiushi_scroll_thumb"
            android:scrollbars="vertical"
            android:fadingEdge="vertical"
            android:fadingEdgeLength="24dp">

            <TextView
                android:id="@+id/qiushi_output"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="true"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:textIsSelectable="true"
                android:text="求是结果将显示在这里..."
                android:textColor="#99E8EAED"
                android:textSize="13sp"
                android:lineSpacingExtra="4dp"
                android:lineSpacingMultiplier="1.15" />

        </ScrollView>

        <!-- ═══ 输入区:文本 + 发送/停止 ═══ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <EditText
                android:id="@+id/qiushi_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxHeight="96dp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:hint="继续追问…"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:textColor="#FFE8EAED"
                android:textColorHint="#66E8EAED"
                android:background="@drawable/bg_qiushi_input"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:textSize="12sp" />

            <Button
                android:id="@+id/qiushi_submit_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_qiushi_send"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="发送" />

            <Button
                android:id="@+id/qiushi_stop_btn"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/btn_qiushi_stop"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:visibility="gone"
                android:text="停止" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
